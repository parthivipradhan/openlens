# ─────────────────────────────────────────────────────────────────────────────
# LocalityLens — Environment Configuration
# Copy this file to .env and fill in values. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# Application
APP_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO

# Database (matches docker-compose defaults)
DATABASE_URL=postgresql+psycopg://localitylens:localitylens_dev@db:5432/localitylens

# AI — local inference (Ollama)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=mistral
AI_REQUEST_TIMEOUT_SECONDS=90

# Set to true to enable clearly-labelled mock AI responses (for UI dev without Ollama)
AI_MOCK_MODE=true

# Data ingestion
INGESTION_ENABLED=false
GEOCODING_PROVIDER=none
MAX_SOURCE_DOWNLOAD_BYTES=5000000
SOURCE_FETCH_TIMEOUT_SECONDS=15

# Evidence archive storage
EVIDENCE_STORAGE_BACKEND=local
EVIDENCE_STORAGE_PATH=./var/evidence

# Blockchain / TrustLayer (DISABLED)
# Offline cryptographic Merkle trees and SHA-256 digests are used locally.
CHAIN_ENABLED=false
CHAIN_ID=
CHAIN_RPC_URL=
EVIDENCE_REGISTRY_ADDRESS=
# WARNING: Never expose this key in the browser or commit it to git
ANCHOR_PRIVATE_KEY=
ANCHOR_BATCH_SIZE=100

# Optional: remote/cloud AI provider (local must always work without this)
REMOTE_AI_ENABLED=false
REMOTE_AI_API_KEY=
REMOTE_AI_MODEL=

# Map
MAPLIBRE_STYLE=https://demotiles.maplibre.org/style.json
